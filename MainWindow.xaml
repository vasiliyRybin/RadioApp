<Window x:Class="RadioApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RadioApp"
        mc:Ignorable="d"
        Title="My Radio Player" 
        Height="350" Width="700" 
        MinWidth="500" MinHeight="300" 
        MaxWidth="700" MaxHeight="350"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock x:Name="NowPlayingTextBlock"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               MaxWidth="200"
                               Margin="0,0,0,14"
                               Text="Now playing: "/>

                    <Grid Margin="0,0,0,14"
                          Width="150"
                          HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="⏮"
                                x:Name="PreviousItemButton"
                                Grid.Column="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="PreviousItemButton_Click"/>

                        <Button Content="▶"
                                x:Name="PlayPauseButton"
                                Grid.Column="1"
                                Click="PlayPauseButton_Click"
                                Margin="2,0,2,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>

                        <Button Content="⏭"
                                x:Name="NextItemButton"
                                Grid.Column="2"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="NextItemButton_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="&#xE995;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                        <Slider x:Name="VolumeSlider"
                                    Width="105"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="80"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged"/>

                        <TextBlock x:Name="VolumeValueTextBlock"
                                   Text="80%"
                                   Width="34"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="NowPlayingTrackTextBlock"
                               Text=""
                               FontSize="12"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               MaxWidth="190"
                               Margin="0,10,0,0"/>

                    <TextBlock x:Name="NowPlayingGenreTextBlock"
                               Text=""
                               FontSize="11"
                               Foreground="Gray"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Internet connectivity status. Lives in the (previously empty)
                 bottom row of the left panel and is anchored to the bottom, so it
                 does not affect the centered player above it. -->
            <StackPanel Grid.Row="1"
                        x:Name="ConnectivityStatusPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">

                <TextBlock x:Name="ConnectivityStatusTextBlock"
                           Text=""
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="170"/>

                <Button x:Name="ConnectNowButton"
                        Content="Connect now"
                        Margin="8,0,0,0"
                        Padding="6,1"
                        FontSize="11"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="ConnectNowButton_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" x:Name="StationsListAndButtonsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="StationsListBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="StationsListBox_PreviewMouseLeftButtonDown"
                     PreviewMouseRightButtonDown="StationsListBox_PreviewMouseRightButtonDown"
                     MouseMove="StationsListBox_MouseMove"
                     Drop="StationsListBox_Drop"
                     MouseDoubleClick="StationsListBox_MouseDoubleClick">

                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play"
                                  Click="ContextPlayMenuItem_Click"/>
                        <MenuItem Header="Edit"
                                  Click="ContextEditMenuItem_Click"/>
                        <MenuItem Header="Delete"
                                  Click="ContextDeleteMenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="Sort by...">

                            <MenuItem Header="Name">
                                <MenuItem Header="Ascending"
                              Click="SortStationsByNameAscendingMenuItem_Click"/>

                                <MenuItem Header="Descending"
                              Click="SortStationsByNameDescendingMenuItem_Click"/>
                            </MenuItem>

                            <MenuItem Header="Play count">
                                <MenuItem Header="Ascending"
                              Click="SortStationsByPlayCountAscendingMenuItem_Click"/>

                                <MenuItem Header="Descending"
                              Click="SortStationsByPlayCountDescendingMenuItem_Click"/>
                            </MenuItem>

                            <MenuItem Header="Played time">
                                <MenuItem Header="Ascending"
                              Click="SortStationsByPlayedTimeAscendingMenuItem_Click"/>

                                <MenuItem Header="Descending"
                              Click="SortStationsByPlayedTimeDescendingMenuItem_Click"/>
                            </MenuItem>

                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap"
                                       MaxWidth="300"/>
                                </ToolTip>
                            </TextBlock.ToolTip>
                            </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <!-- Live search box. Hidden until the magnifier button is toggled; sits above
                 the +/-/edit/search buttons and filters the list by station name. -->
            <TextBox x:Name="SearchTextBox"
                     Grid.Row="1"
                     Margin="0,2,0,2"
                     Padding="4,2"
                     VerticalContentAlignment="Center"
                     Visibility="Collapsed"
                     TextChanged="SearchTextBox_TextChanged"/>

            <Grid Grid.Row="2" x:Name="PlaylistButtonGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AddButton" FontFamily="Segoe MDL2 Assets"
                        Content="&#xE710;"
                        FontSize="22"
                        ToolTip="Add station"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" Click="AddButton_Click"/>

                <Button Grid.Column="1" x:Name="DeleteButton"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE738;"
                        FontSize="22"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip="Delete station" 
                        Click="DeleteButton_ClickAsync"/>

                <Button x:Name="EditButton"
                        Grid.Column="2" 
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE70F;"
                        FontSize="20"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip="Edit station" 
                        Click="EditButton_Click"/>

                <Button x:Name="SearchToggleButton"
                        Grid.Column="3"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE721;"
                        FontSize="20"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip="Search stations" 
                        Click="SearchToggleButton_Click"/>
            </Grid>

        </Grid>
    </Grid>
</Window>
